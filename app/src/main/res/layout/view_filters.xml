<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/filter_group" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleLine="true" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/filter_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_all" android:textColor="#F4D9EA" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeWidth="0dp"/>
            <com.google.android.material.chip.Chip android:id="@+id/filter_standard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_standard" android:textColor="#F4D9EA" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeWidth="0dp"/>
            <com.google.android.material.chip.Chip android:id="@+id/filter_vip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_vip" android:textColor="#F4D9EA" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeWidth="0dp"/>
            <com.google.android.material.chip.Chip android:id="@+id/filter_couple" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_couple" android:textColor="#F4D9EA" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeWidth="0dp"/>
            <com.google.android.material.chip.Chip android:id="@+id/filter_available" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/filter_available" android:textColor="#F4D9EA" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/chip_background" app:chipStrokeWidth="0dp"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/seat_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="@string/search_hint" android:inputType="textCapCharacters" android:singleLine="true" android:imeOptions="actionDone" android:textColor="#F7E2F1" android:textColorHint="#B396AF" android:backgroundTint="#8D5B7D" android:textSize="13sp" android:paddingStart="8dp" android:paddingEnd="8dp"/>
        <Button android:id="@+id/clear_filters" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/clear_filters" android:textAllCaps="false" android:textSize="11sp" android:backgroundTint="#50304F" android:textColor="#FFE5F2"/>
    </LinearLayout>
    <TextView android:id="@+id/filter_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="4dp" android:textSize="11sp" android:textColor="#C9ABC1" android:accessibilityLiveRegion="polite"/>
</LinearLayout>
