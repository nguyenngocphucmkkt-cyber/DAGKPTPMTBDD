<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:padding="12dp" android:background="@drawable/panel_background" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFE5F2" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/row_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#C9ABC1" android:textSize="12sp"/>
    </LinearLayout>
    <Button android:id="@+id/remove_seat" android:textSize="12sp" android:padding="0dp" android:maxLines="1" android:layout_width="64dp" android:layout_height="48dp" android:text="@string/remove_seat" android:textAllCaps="false" android:backgroundTint="#653554" android:textColor="#FFE5F2"/>
</LinearLayout>
