<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
    <Button android:id="@+id/zoom_out" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:contentDescription="@string/zoom_out" android:backgroundTint="#50304F" android:textColor="#FFE5F2" android:padding="0dp"/>
    <Button android:id="@+id/zoom_in" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:contentDescription="@string/zoom_in" android:backgroundTint="#50304F" android:textColor="#FFE5F2" android:padding="0dp"/>
    <Button android:id="@+id/reset_view" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/reset_view" android:textSize="11sp" android:textAllCaps="false" android:backgroundTint="#50304F" android:textColor="#FFE5F2"/>
</LinearLayout>
